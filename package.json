{
  "name": "spectacles",
  "displayName": "spectacles",
  "description": "A set of tools for spec-driven development.",
  "version": "0.0.1",
  "publisher": "Matthew Holliday",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spectacles.init",
        "title": "Init",
        "category": "Spectacles"
      },
      {
        "command": "spectacles.validateProject",
        "title": "Validate Project",
        "category": "Spectacles"
      },
      {
        "command": "spectacles.codeToSpec",
        "title": "Code-to-Spec",
        "category": "Spectacles"
      },
      {
        "command": "spectacles.specToCode",
        "title": "Spec-to-Code",
        "category": "Spectacles"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spectacles.codeToSpec",
          "group": "navigation@1"
        },
        {
          "command": "spectacles.specToCode",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
